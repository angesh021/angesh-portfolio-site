{
  "version": 2,
  "functions": {
    "api/*.ts": {
      "includeFiles": "{lib,routes,content}/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 0 */3 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.ts"
    },
    {
      "source": "/api/send-email",
      "destination": "/api/send-email.ts"
    },
    {
      "source": "/api/metrics",
      "destination": "/api/metrics.ts"
    },
    {
      "source": "/api/errors",
      "destination": "/api/errors.ts"
    },
    {
      "source": "/api/contact-event",
      "destination": "/api/contact-event.ts"
    },
    {
      "source": "/api/security-event",
      "destination": "/api/security-event.ts"
    },
    {
      "source": "/api/engagement-event",
      "destination": "/api/engagement-event.ts"
    },
    {
      "source": "/api/admin/dashboard",
      "destination": "/api/admin-dashboard.ts"
    },
    {
      "source": "/api/download-resume",
      "destination": "/api/download-resume.ts"
    },
    {
      "source": "/api/cv/metadata",
      "destination": "/api/cv-metadata.ts"
    },
    {
      "source": "/api/assistant/(.*)",
      "destination": "/api/assistant.ts"
    },
    {
      "source": "/api/portfolio-assistant/(.*)",
      "destination": "/api/assistant.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
